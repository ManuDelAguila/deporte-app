{
  "expo": {
    "name": "deporte-app",
    "slug": "deporte-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "deporteapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.manudelaguila.deporteapp"
    },
    "android": {
      "package": "com.manudelaguila.deporteapp",
      "permissions": [
        "android.permission.health.READ_STEPS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Deporte App necesita acceder al movimiento para calcular tus pasos."
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
