{
  "expo": {
    "name": "deporte-app",
    "slug": "deporte-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "deporteapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.manudelaguila.deporteapp"
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF"
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Deporte App necesita acceder al movimiento para calcular tus pasos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
