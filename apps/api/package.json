{
  "name": "@deporte/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
 "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "auth:generate": "auth generate --config ./src/auth.ts",
    "auth:migrate": "auth migrate --config ./src/auth.ts"
  },
  "dependencies": {
    "@better-auth/expo": "^1.7.4",
    "better-auth": "^1.7.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "auth": "1.7.4",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  }
}